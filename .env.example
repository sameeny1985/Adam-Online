# کپی این فایل به .env و مقادیر را پر کنید

# توکن ربات تلگرام (از @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# آیدی کانال یا چت (مثل @MyIranNews یا -1001234567890)
TELEGRAM_CHANNEL_ID=@YourChannelName

# رمز برای تریگر دستی فچ (اختیاری)
FETCH_SECRET=my-super-secret-key-change-this

# پورت (Render خودش PORT را می‌دهد)
PORT=5000
